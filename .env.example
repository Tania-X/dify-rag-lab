# Dify RAG Lab 容器化部署环境变量
# 复制为 .env 后按需填写：
#   cp .env.example .env

# Dify 服务地址（容器内使用服务名）
DIFY_BASE_URL=http://nginx:80
DIFY_DATASET_API_KEY=
DIFY_APP_API_KEY=
DIFY_DATASET_ID=

# Weaviate（容器内使用服务名）
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=

# Embedding（用于向量库直查/对照实验）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# Query Rewrite
REWRITE_ENABLED=false
REWRITE_BASE_URL=https://api.deepseek.com/v1
REWRITE_API_KEY=
REWRITE_MODEL=deepseek-chat
